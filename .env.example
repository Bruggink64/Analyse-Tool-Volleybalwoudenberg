# GEMINI_API_KEY: verplicht voor de AI-analyse (Google AI Studio > API keys).
# Zet deze NOOIT in de code of in git; alleen in .env (lokaal) of als geheime variabele bij de host.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_ACCESS_CODE: sterk aangeraden bij een publieke URL. Alleen wie deze code invult kan
# een (betaalde) Gemini-analyse starten. Leeg laten = iedereen met de link kan je quotum gebruiken.
APP_ACCESS_CODE=""

# Optioneel: ander Gemini-model gebruiken zonder de code aan te passen.
# GEMINI_MODEL="gemini-4-hydrogen"
# GEMINI_FAST_MODEL="gemini-3.1-flash-lite"

# Optioneel: max. aantal analyse-aanvragen per IP-adres per 10 minuten (standaard 60).
# RATE_LIMIT_MAX="60"

# APP_URL: The URL where this applet is hosted (wordt door AI Studio ingevuld).
APP_URL="MY_APP_URL"
